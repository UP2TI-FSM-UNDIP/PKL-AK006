package "Route Groups" <<Rectangle>> #EFEBE9 {

  class "letter/ak006\n(Mahasiswa)" as RouteAK006 <<routes>> {
    POST /letter/ak006
    GET /letter/ak006
    GET /letter/ak006/:id
    PUT /letter/ak006/:id
    POST /letter/ak006/:id/resubmit
    POST /letter/ak006/:id/self-revise
    DELETE /letter/ak006/:id
  }

  class "letter/ak006-sa\n(Supervisor Akademik)" as RouteSA <<routes>> {
    GET /letter/ak006/sa
    POST /letter/ak006/sa/:id/approve
    POST /letter/ak006/sa/:id/reject
    POST /letter/ak006/sa/:id/revision
  }

  class "letter/ak006-mtu\n(Manajer TU)" as RouteMTU <<routes>> {
    GET /letter/ak006/mtu
    POST /letter/ak006/mtu/:id/sign
    POST /letter/ak006/mtu/:id/forward
    POST /letter/ak006/mtu/:id/reject
    POST /letter/ak006/mtu/:id/revision
  }

  class "letter/ak006-upa\n(UPA)" as RouteUPA <<routes>> {
    GET /letter/ak006/upa
    POST /letter/ak006/upa/:id/finalize
    POST /letter/ak006/upa/:id/reject
    GET /letter/ak006/upa/archived
