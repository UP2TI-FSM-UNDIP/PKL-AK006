  class "master/*\n(Superadmin)" as RouteMaster <<routes>> {
    CRUD /master/user
    CRUD /master/role
    CRUD /master/permission
    CRUD /master/mahasiswa
    CRUD /master/pegawai
    CRUD /master/departemen
    CRUD /master/prodi
    CRUD /master/suratType
    CRUD /master/suratTemplate
  }

  class "public/*\n(Unauthenticated)" as RoutePublic <<routes>> {
    POST /public/register
    POST /public/sign-in
    GET /public/verify
    GET /public/reference
    GET /public/files/:name
    GET /public/template/:id
  }

  class "auth/sso\n(SSO)" as RouteSSO <<routes>> {
    GET /auth/sso/redirect
    GET /auth/sso/callback
    POST /auth/sso/session
  }

  class "Other Routes" as RouteOther <<routes>> {
    GET /me
    PUT /me
    GET /dash
    POST /upload
    GET /notification
    PATCH /notification/:id/read
    PATCH /notification/read-all
  }
}

