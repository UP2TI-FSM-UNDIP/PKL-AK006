  class NotificationService <<singleton>> {
    +createNotification(params): Promise<Notification>
    +createNotificationForRole(role, params): Promise<Notification[]>
    +getNotifications(userId, limit?, unreadOnly?): Promise<Notification[]>
    +getUnreadCount(userId): Promise<number>
    +markAsRead(notifId, userId): Promise<void>
    +markAllAsRead(userId): Promise<void>
    +deleteNotification(notifId, userId): Promise<void>
    ' ── Business Helpers ──
    +notifySANewLetter(letterId, name, type): Promise<void>
    +notifyMTULetterVerified(letterId, name, type): Promise<void>
    +notifyUPALetterSigned(letterId, name, type): Promise<void>
    +notifyMahasiswaRevision(userId, letterId, type, comments, role): Promise<void>
    +notifySARevision(letterId, type, name, comments): Promise<void>
    +notifyMahasiswaRejection(userId, letterId, type, comments, role): Promise<void>
    +notifyMahasiswaCompleted(userId, letterId, type): Promise<void>
    +notifyMahasiswaVerified(userId, letterId, type): Promise<void>
    +notifyMahasiswaSigned(userId, letterId, type): Promise<void>
  }

  class EmailService <<module>> {
    -transporter: Nodemailer  {private}
    +sendEmail(params): Promise<boolean>
    +sendVerificationEmail(to, url): Promise<boolean>
    +sendPasswordResetEmail(to, url): Promise<boolean>
  }

  class CasbinService <<module>> {
    -enforcer: Enforcer?  {private, lazy}
    +getEnforcer(): Promise<Enforcer>
    +checkPermission(userId, resource, action): Promise<boolean>
    +addPermissionToRole(role, resource, action): Promise<boolean>
    +removePermissionFromRole(role, resource, action): Promise<boolean>
    +assignRoleToUser(userId, role): Promise<boolean>
    +removeRoleFromUser(userId, role): Promise<boolean>
    +getUserRoles(userId): Promise<string[]>
    +getRolePermissions(role): Promise<string[][]>
  }
}

NotificationService ..> Notification  : creates

' ============================================================
' AUTH / MIDDLEWARE LAYER
' ============================================================
package "Auth & Middleware" <<Rectangle>> #F3E5F5 {

  interface PermissionProps {
    +resource: String
    +action: String
  }

  interface RequiredRoleProps {
    +requiredRole: String
  }

  class AuthGuardPlugin <<ElysiaPlugin>> {
    +mount(auth.handler)
    +resolve(headers): {user, session}
    +macro permission(props): resolve
    +macro role(props): resolve
  }

  class BetterAuth <<module>> {
    +handler: fetch handler
    +api.getSession(headers): Promise<Session>
    ' Plugins: Prisma, Anonymous, Bearer
  }

  note right of AuthGuardPlugin
    Macros usable on any route:
    • permission: { resource, action }
      → Casbin RBAC check
    • role: { requiredRole }
      → Direct role membership check
  end note
}

AuthGuardPlugin ..> BetterAuth      : delegates session to
AuthGuardPlugin ..> CasbinService   : calls checkPermission
AuthGuardPlugin ..> PermissionProps : uses
AuthGuardPlugin ..> RequiredRoleProps : uses

