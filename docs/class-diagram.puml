    +downloadFile(objectName, downloadPath): Promise<void>  {static}
    +getPresignedUrl(jenisFile, objectName, expiry): Promise<string>  {static}
    +getFileStream(location): Promise<{stat, stream}>  {static}
    +listObjects(prefix?): Promise<string[]>  {static}
    +deleteFile(jenisFile, objectName): Promise<void>  {static}
